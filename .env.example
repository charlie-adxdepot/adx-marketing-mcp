# ---------------------------------------------------------------------------
# ADX Marketing Knowledge - SharePoint MCP Connector
# Copy this file to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

APP_ENV=local
APP_DEBUG=true

# Existing Entra app: "Claude Marketing SharePoint Connector"
# (app-only, Files.SelectedOperations.Selected). Do not register a new app.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# The drive (document library) and the "Agent Knowledge" folder item ID.
# These are the same IDs used in the PowerShell tests.
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ROOT_FOLDER_ID=

MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8080

# LOCAL TEST CREDENTIAL ONLY. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Clients send it as:  Authorization: Bearer <token>
MCP_AUTH_TOKEN=
MCP_MAX_DOCUMENT_SIZE_MB=20
MCP_MAX_RESPONSE_CHARS=30000

# debug | info | notice | warning | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Optional settings (sensible defaults are used when blank)
# ---------------------------------------------------------------------------

# How clients authenticate to this MCP server:
#   static = shared bearer token (MCP_AUTH_TOKEN). Local testing, or Claude
#            "Request headers" (beta) if your org has access.
#   oauth  = validate OAuth 2.0 JWT access tokens from MCP_OAUTH_ISSUER.
#            Intended for production. See README "Production authentication".
MCP_AUTH_MODE=static

# Public URL of the MCP endpoint. Advertised in RFC 9728 metadata.
# Must be https:// except for localhost/127.0.0.1.
MCP_PUBLIC_URL=http://127.0.0.1:8080/mcp

# Comma-separated Host header values accepted (DNS rebinding protection).
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- OAuth mode only (MCP_AUTH_MODE=oauth) ----------------------------------
# Staff sign-in uses a SEPARATE Entra app registration (the "OAuth API app"),
# not the Graph app above. See docs/oauth-implementation.md.
#
# Tenant-specific Entra v2.0 issuer (the API app must issue v2.0 tokens:
# requestedAccessTokenVersion = 2). "common"/"organizations" are refused.
#   MCP_OAUTH_ISSUER=https://login.microsoftonline.com/<ADX_TENANT_ID>/v2.0
MCP_OAUTH_ISSUER=
# The OAuth API app's Application (client) ID GUID - NOT the api:// URI.
# (v2.0 access tokens always carry the client ID in "aud".)
#   MCP_OAUTH_AUDIENCE=<OAUTH_API_CLIENT_ID>
MCP_OAUTH_AUDIENCE=
# Must be "scp" for Entra delegated (user) tokens.
MCP_OAUTH_SCOPE_CLAIM=scp
# Bare scope name(s) as they appear in the token's scp claim. Enforced on every request.
#   MCP_OAUTH_REQUIRED_SCOPES=access_as_user
MCP_OAUTH_REQUIRED_SCOPES=
# Full scope(s) a client must REQUEST from Entra (space or comma separated).
# Published in /.well-known/oauth-protected-resource and WWW-Authenticate.
# Use the Application ID URI that equals MCP_PUBLIC_URL, plus offline_access
# so Claude receives refresh tokens:
#   MCP_OAUTH_ADVERTISED_SCOPES=https://<MCP_HOST>/mcp/access_as_user offline_access
MCP_OAUTH_ADVERTISED_SCOPES=
# Optional (recommended): app role value(s) every user must hold (roles claim).
# Assign the staff security group to this role in the Enterprise Application.
#   MCP_OAUTH_REQUIRED_ROLES=MCP.Access
MCP_OAUTH_REQUIRED_ROLES=
# Optional: only accept tokens issued to these OAuth client IDs (azp claim),
# i.e. the client registration entered in Claude's connector settings.
#   MCP_OAUTH_ALLOWED_CLIENT_IDS=<CLAUDE_OAUTH_CLIENT_ID>
MCP_OAUTH_ALLOWED_CLIENT_IDS=
# Optional: advertise a different authorization server in RFC 9728 metadata
# (an OAuth intermediary/broker in front of Entra). Defaults to MCP_OAUTH_ISSUER.
MCP_OAUTH_AUTHORIZATION_SERVER=

# How long the folder index (list of allowed files) is cached, in seconds.
SHAREPOINT_INDEX_TTL_SECONDS=600
# Safety caps for walking the folder tree.
SHAREPOINT_MAX_INDEX_ITEMS=5000
SHAREPOINT_MAX_FOLDER_DEPTH=15

# How long extracted document text is cached (encrypted on disk) so reading the
# next page of a long document does not re-download the file. 0 disables it.
SHAREPOINT_TEXT_CACHE_TTL_SECONDS=3600

# Production safety: APP_ENV=production refuses to start with MCP_AUTH_MODE=static
# (a shared secret, intended for local testing) unless you set this to true on purpose.
MCP_ALLOW_STATIC_AUTH_IN_PRODUCTION=false

# Writable directory for token/index cache and logs (relative to project root).
STORAGE_PATH=var
