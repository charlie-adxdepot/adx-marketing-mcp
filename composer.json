{
    "name": "adxdepot/marketing-mcp",
    "description": "ADX Marketing Knowledge - read-only MCP connector for the SharePoint 'Agent Knowledge' folder.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "ext-libxml": "*",
        "ext-dom": "*",
        "mcp/sdk": "^0.10",
        "guzzlehttp/guzzle": "^7.10",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.7",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "smalot/pdfparser": "^2.11",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "symfony/cache": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Adx\\MarketingMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Adx\\MarketingMcp\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 127.0.0.1:8080 -t public public/index.php"
        ],
        "test": "phpunit",
        "check-graph": "@php bin/check-graph.php"
    }
}
